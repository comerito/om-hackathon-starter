# Upgrade baseline artifacts (large, regenerable via .ai/upgrade/harness/run.sh).
# Must be recursive: the per-stage archives live in baseline/archive-*/ subdirectories,
# which a single-level *.json glob does not match.
.ai/upgrade/baseline/

# MikroORM snapshots for the throwaway upgrade database (the canonical
# .snapshot-open-mercato.json files stay tracked)
src/modules/*/migrations/.snapshot-om_upgrade.json

# Playwright / integration test output
.ai/qa/test-results/
test-results/
playwright-report/
.ai/qa/ephemeral-*.json
.ai/qa/ephemeral-*.sqlite*
.ai/qa/test-results/

# Local sqlite cache (CACHE_STRATEGY=sqlite) — runtime artifact
data/cache.db
data/cache.db-shm
data/cache.db-wal
