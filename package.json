{
  "name": "hackathon-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "dev": "mercato server dev",
    "build": "next build",
    "start": "NODE_OPTIONS='-r newrelic' mercato server start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "generate": "mercato generate",
    "install-skills": "sh ./scripts/install-skills.sh",
    "db:generate": "mercato db generate",
    "db:migrate": "mercato db migrate",
    "db:greenfield": "mercato db greenfield",
    "initialize": "mercato init",
    "reinstall": "mercato init --reinstall",
    "preinstall": "node -e \"const v = process.versions.node.split('.').map(Number); if (v[0] < 24) { console.error('Node >= 24 required'); process.exit(1); }\"",
    "test:integration": "mercato test:integration",
    "test:integration:ephemeral": "mercato test:ephemeral",
    "upgrade:verify": "bash .ai/upgrade/harness/run.sh verify",
    "upgrade:record": "bash .ai/upgrade/harness/run.sh record"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.54",
    "@ai-sdk/openai": "^4.0.67",
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/decorators": "^7.2.0",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/postgresql": "^7.2.0",
    "@open-mercato/ai-assistant": "0.6.7",
    "@open-mercato/cache": "0.6.7",
    "@open-mercato/cli": "0.6.7",
    "@open-mercato/content": "0.6.7",
    "@open-mercato/core": "0.6.7",
    "@open-mercato/events": "0.6.7",
    "@open-mercato/gateway-stripe": "0.6.7",
    "@open-mercato/onboarding": "0.6.7",
    "@open-mercato/queue": "0.6.7",
    "@open-mercato/scheduler": "0.6.7",
    "@open-mercato/search": "0.6.7",
    "@open-mercato/shared": "0.6.7",
    "@open-mercato/ui": "0.6.7",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-email/components": "^1.0.12",
    "@stripe/react-stripe-js": "^3.11.0",
    "@stripe/stripe-js": "^7.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.20.5",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@uiw/react-md-editor": "^4.1.2",
    "ai": "^7.0.102",
    "awilix": "^12.0.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "language-subtag-registry": "^0.4.2",
    "lucide-react": "^0.556.0",
    "newrelic": "^13.20.0",
    "next": "16.3.5",
    "octokit": "^5.0.5",
    "pdf2pic": "^3.2.0",
    "pg": "8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.3.0",
    "react-email": "^5.2.11",
    "react-is": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "resend": "^6.28.1",
    "semver": "^7.8.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/semver": "^7.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "jest": "^30.5.1",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1"
  },
  "imports": {
    "#generated/entities.ids.generated": {
      "types": "./.mercato/generated/entities.ids.generated.ts",
      "default": "./.mercato/generated/entities.ids.generated.mjs"
    },
    "#generated/entity-fields-registry": {
      "types": "./.mercato/generated/entity-fields-registry.ts",
      "default": "./.mercato/generated/entity-fields-registry.ts"
    },
    "#generated/entities/*": {
      "types": "./.mercato/generated/entities/*/index.ts",
      "default": "./.mercato/generated/entities/*/index.ts"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "resolutions": {
    "typescript": "^5.9.3"
  }
}
